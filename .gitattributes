# Normaliza line endings: LF no repositório, conversão automática no checkout
* text=auto eol=lf

# Scripts/arquivos específicos do Windows precisam de CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Scripts Unix precisam de LF (independente da plataforma do clone)
*.sh    text eol=lf
mvnw    text eol=lf

# Código-fonte: força LF
*.go    text eol=lf
*.java  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.puml  text eol=lf

# Binários (não normalizar)
*.jar   binary
*.png   binary
*.jpg   binary
*.svg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
